PORT=4000
ADMS_PORT=8081
DATABASE_URL=postgres://postgres:postgres@localhost:5432/attendance
CORS_ORIGIN=http://localhost:5173
DEVICE_ONLINE_WINDOW_MS=90000
ADMS_TIMEZONE=5
ADMS_AUTO_REGISTER=true
ADMS_LOG_RAW=true

# Optional
# NODE_ENV=production     # `node dist/index.js` defaults to production; `tsx watch` to development
# LOG_LEVEL=info          # fatal|error|warn|info|debug|trace|silent (ADMS requests log at debug)
# LOG_PRETTY=false        # force pretty (true) or JSON (false) logs

# Authentication (Phase B)
# The Super Admin is created at first start if none exists; the password must be changed at first sign-in.
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=change-me-before-first-start
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
COOKIE_SECURE=false      # set true when the web app is served over HTTPS
